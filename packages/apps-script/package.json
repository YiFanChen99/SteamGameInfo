{
  "name": "@watchlist/apps-script",
  "version": "0.1.0",
  "private": true,
  "description": "Apps Script web app that queries and writes the watchlist sheet",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "push": "pnpm build && pnpm dlx @google/clasp push --force"
  },
  "dependencies": {
    "@watchlist/core": "workspace:*",
    "@watchlist/sheet-api": "workspace:*"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0"
  }
}
